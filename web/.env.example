# ---------------------------------------------------------------------------
# Plataforma web institucional de Abudemy — variables de entorno (Vite)
# Copia este archivo a `.env` y ajusta los valores. Solo las variables con el
# prefijo VITE_ se exponen al código del navegador.
# ---------------------------------------------------------------------------

# URL base de la API REST de Abudemy. Déjala vacía en desarrollo para usar el
# proxy de Vite (mismo origen, sin CORS). En producción usa la URL absoluta,
# por ejemplo https://abudemy-api.onrender.com (Render).
# En Cloudflare Pages se define como variable de entorno de BUILD.
VITE_API_BASE_URL=

# Modo demostración. Con `true`, TODAS las respuestas provienen de un adaptador
# de datos ficticios marcados con «[DEMO]» y la interfaz muestra un aviso
# permanente. El valor por defecto es `false` y utiliza el backend real.
VITE_DEMO_MODE=false

# Destino del proxy de desarrollo de Vite para /api, /healthz y /readyz.
VITE_PROXY_TARGET=http://localhost:8080
