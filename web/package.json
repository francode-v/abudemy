{
  "name": "abudemy-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Plataforma web institucional de Abudemy (React + TypeScript)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
