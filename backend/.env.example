# Abudemy backend configuration.
# Copy this file to `.env` and adjust the values. Never commit real secrets.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development            # development | staging | production
# Si HTTP_ADDR está vacío se usa la variable PORT (Render) y, si no, :8080.
HTTP_ADDR=:8080
LOG_LEVEL=info                 # debug | info | warn | error

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://abudemy:abudemy@localhost:5432/abudemy?sslmode=disable
# Neon: postgres://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
# Tamaño máximo del pool (Neon gratis admite pocas conexiones; 5 alcanza).
DB_MAX_CONNS=10
# Aplica las migraciones con datos de demostración (cuentas con claves PÚBLICAS).
# Por defecto: true en development, false en staging/production.
# SEED_DEMO_DATA=false

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# REQUIRED. Use a long random value (>= 32 bytes) outside development.
JWT_SECRET=change-me-with-a-long-random-secret-value-32
JWT_ISSUER=abudemy
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
PASSWORD_RESET_TTL=1h
BCRYPT_COST=12

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# none     -> no provider; assistance alerts are recorded as "skipped"
# log      -> development only; notifications are written to the log
# webhook  -> POST JSON to NOTIFY_WEBHOOK_URL
NOTIFY_PROVIDER=none
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Assistant (virtual help)
# ---------------------------------------------------------------------------
# The assistant always answers from the curated, non-AI knowledge base. Set a
# provider only if you want answers to come from an external service.
# none    -> curated knowledge base only (source: knowledge_base, ai: false)
# webhook -> POST {"question": ...} to ASSISTANT_WEBHOOK_URL and read "answer"
ASSISTANT_PROVIDER=none
ASSISTANT_WEBHOOK_URL=
ASSISTANT_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Geocoding
# ---------------------------------------------------------------------------
# none      -> geocoding endpoints return 501 instead of inventing coordinates
# nominatim -> query an OpenStreetMap Nominatim compatible endpoint
GEOCODE_PROVIDER=none
# GEOCODE_BASE_URL=https://nominatim.openstreetmap.org
# A descriptive User-Agent is required by the Nominatim usage policy.
# GEOCODE_USER_AGENT=Abudemy/1.0 (contact: soporte@abudemy.cl)

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# No online payment provider is available. This is intentional: the platform
# reports payments as unavailable rather than faking a checkout.
PAYMENTS_PROVIDER=none

# ---------------------------------------------------------------------------
# HTTP / CORS
# ---------------------------------------------------------------------------
# Orígenes separados por coma. Admite un comodín de subdominio, útil para las
# URLs de preview de Cloudflare Pages:
#   CORS_ALLOWED_ORIGINS=https://abudemy.pages.dev,https://*.abudemy.pages.dev
CORS_ALLOWED_ORIGINS=*

# ---------------------------------------------------------------------------
# Optional bootstrap administrator (created on first start when both are set)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Integration tests (dedicated database whose name contains "test")
# ---------------------------------------------------------------------------
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/abudemy_test?sslmode=disable
