# Variables del stack local de Docker Compose (PostgreSQL + API).
# Copia este archivo a `.env` en la raíz del repositorio. Los valores por
# defecto permiten `docker compose up` sin configuración adicional.
#
# Nota: para ejecutar la API directamente (sin Docker, contra tu propio
# PostgreSQL) usa `backend/.env.example`.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=abudemy
POSTGRES_PASSWORD=abudemy
POSTGRES_DB=abudemy
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=8080
# REQUIRED. Usa un valor aleatorio largo (>= 32 bytes) fuera de desarrollo.
JWT_SECRET=change-me-with-a-long-random-secret-value-32

# ---------------------------------------------------------------------------
# Notificaciones
# ---------------------------------------------------------------------------
# none -> sin proveedor; las alertas de asistencia se registran como "skipped"
# log  -> solo desarrollo; las notificaciones se escriben en el log
# webhook -> POST JSON a NOTIFY_WEBHOOK_URL
NOTIFY_PROVIDER=none
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=*
